# CareerBridge Backend API URL (có thể là http://localhost:3000 hoặc URL server công ty)
BACKEND_URL=http://localhost:3000

# Worker Token do doanh nghiệp tạo trên web CareerBridge (bắt đầu bằng cwb_...)
WORKER_TOKEN=cwb_your_worker_secret_token_here

# Tên định danh Worker hiển thị trên Dashboard (tùy chọn)
WORKER_NAME=Company-Local-Worker-01

# Chế độ AI:
# - "mock": Dùng thuật toán so khớp từ khóa nội bộ (dành cho môi trường dev/test, không cần cài Ollama)
# - "ollama": Dùng Local LLM nội bộ qua máy chủ Ollama
AI_PROVIDER=mock

# Cấu hình Ollama (chỉ cần khi AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Chu kỳ kiểm tra việc mới (giây, mặc định 5s)
POLL_INTERVAL_SEC=5

# Chu kỳ gửi tín hiệu sống Heartbeat (giây, mặc định 25s)
HEARTBEAT_INTERVAL_SEC=25
