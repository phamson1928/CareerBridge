# CareerBridge Backend API URL
BACKEND_URL=http://localhost:3000

# Worker Token do doanh nghiệp tạo trên web CareerBridge (bắt đầu bằng cwb_...)
WORKER_TOKEN=cwb_your_worker_secret_token_here

# Tên định danh Worker hiển thị trên Dashboard (tùy chọn)
WORKER_NAME=Company-Local-Worker-01

# ==============================================================================
# CHỌN CHẾ ĐỘ AI (AI_PROVIDER):
# 1. "openai-compatible" hoặc "vllm": Chuẩn phổ quát hỗ trợ BẤT KỲ máy chủ AI nào
#    (vLLM, LocalAI, llama.cpp server, TGI, LiteLLM, Ollama v1...)
# 2. "ollama": Chạy cổng riêng native của Ollama
# 3. "mock": Bộ lọc so khớp kỹ năng tích hợp sẵn (không cần card GPU / AI Server)
# ==============================================================================
AI_PROVIDER=openai-compatible

# Cấu hình địa chỉ Server AI & Tên mô hình:
# Ví dụ vLLM:               http://localhost:8000/v1
# Ví dụ llama.cpp:          http://localhost:8080/v1
# Ví dụ LocalAI:            http://localhost:8080/v1
# Ví dụ Ollama:             http://localhost:11434/v1
# Ví dụ Máy chủ mạng LAN:   http://192.168.1.50:8000/v1
AI_BASE_URL=http://localhost:8000/v1
AI_MODEL=qwen2.5:7b

# API Key / Bearer Token nếu máy chủ nội bộ của công ty có đặt mật khẩu (tùy chọn)
# AI_API_KEY=your-secret-internal-key

# Chu kỳ kiểm tra việc mới (giây, mặc định 5s)
POLL_INTERVAL_SEC=5

# Chu kỳ gửi tín hiệu sống Heartbeat (giây, mặc định 25s)
HEARTBEAT_INTERVAL_SEC=25
