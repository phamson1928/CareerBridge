generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  STUDENT
  LECTURER
  COMPANY
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING_VERIFICATION
  BANNED
}

enum CompanyStatus {
  DRAFT
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum CompanyRejectionReasonCode {
  MISSING_DOCUMENT
  DOCUMENT_UNCLEAR
  NAME_MISMATCH
  REGISTRATION_MISMATCH
  ADDRESS_MISMATCH
  CONTACT_INVALID
  OTHER
}

enum CompanySuspensionReasonCode {
  POLICY_VIOLATION
  FAKE_INFORMATION
  ABUSIVE_POSTING
  LEGAL_COMPLAINT
  OTHER
}

enum SemesterStatus {
  UPCOMING
  ACTIVE
  RECRUITING
  MONITORING
  COMPLETED
  CANCELLED
}

enum InternshipStatus {
  DRAFT
  OPEN
  CLOSED
  CANCELLED
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  INTERVIEWING
  OFFERED
  ACCEPTED
  DECLINED
  EXPIRED
  REJECTED
  WITHDRAWN
}

enum InterviewMode {
  ONLINE
  OFFLINE
}

enum EmailLogType {
  INTERVIEW_INVITATION
  OFFER_SENT
  OFFER_REMINDER
  OFFER_ACCEPTED_COMPANY
  OFFER_DECLINED_COMPANY
  OFFER_EXPIRED
  APPLICATION_REJECTED
  APPLICATION_WITHDRAWN_BY_PLACEMENT
  APPLICATION_CAMPAIGN_EXPIRED
}

enum EmailLogStatus {
  SENT
  FAILED
}

enum PlacementStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
}

enum AcademicMonitoringStatus {
  PENDING
  ACTIVE
  CLOSED
  CANCELLED
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum SupervisionStatus {
  ACTIVE
  COMPLETED
  CANCELLED
}

enum RecommendationSource {
  AI_ENHANCED
  DETERMINISTIC_FALLBACK
  DETERMINISTIC_ONLY
}

enum EvaluationType {
  COMPANY
  LECTURER
}

enum FileType {
  CV
  REPORT
  CERTIFICATE
  COMPANY_REGISTRATION
  AVATAR
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum SupportRequestStatus {
  PENDING
  RESOLVED
}

enum NotificationType {
  APPLICATION
  REPORT
  SUPERVISION
  PLACEMENT
  COMPANY
  EVALUATION
  SYSTEM
}

enum NotificationAction {
  NONE
  OPEN_APPLICATION
  OPEN_REPORT
  OPEN_SUPERVISION
  OPEN_PLACEMENT
  OPEN_COMPANY_PROFILE
  OPEN_EVALUATION
  OPEN_SUPPORT_REQUEST
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  passwordHash    String
  role            Role
  status          UserStatus @default(PENDING_VERIFICATION)
  emailVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  studentProfile         StudentProfile?
  lecturerProfile        LecturerProfile?
  companyProfile         CompanyProfile?
  refreshTokens          RefreshToken[]
  files                  File[]               @relation("FileOwner")
  sentMessages           Message[]            @relation("SentMessages")
  notifications          Notification[]
  auditLogs              AuditLog[]
  companyReviews         CompanyProfile[]     @relation("CompanyReviewedBy")
  supervisedPlacements   Supervision[]        @relation("AssignedBy")
  evaluations            Evaluation[]         @relation("EvaluationAuthor")
  verificationTokens     VerificationToken[]
  passwordResetTokens    PasswordResetToken[]
  repliedSupportRequests SupportRequest[]     @relation("SupportRepliedBy")
  internshipViews        InternshipView[]
}

model VerificationToken {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ipAddress String?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model StudentProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  studentCode  String   @unique
  fullName     String
  major        String
  phone        String?
  summary      String?
  gpa          Float?
  cvFileId     String?  @unique
  avatarFileId String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user                User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  cvFile              File?                          @relation("StudentCv", fields: [cvFileId], references: [id], onDelete: SetNull)
  avatarFile          File?                          @relation("StudentAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)
  skills              StudentSkill[]
  projects            StudentProject[]
  applications        Application[]
  placements          InternshipPlacement[]
  conversations       Conversation[]
  jobPreference       StudentJobPreference?
  recommendationCache InternshipRecommendationCache?
  supportRequests     SupportRequest[]
}

model StudentJobPreference {
  id                 String   @id @default(cuid())
  studentId          String   @unique
  desiredRoles       String[] @default([])
  preferredLocations String[] @default([])
  preferredWorkTypes String[] @default([])
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

model InternshipRecommendationCache {
  id          String               @id @default(cuid())
  studentId   String               @unique
  fingerprint String               @db.VarChar(64)
  result      Json
  source      RecommendationSource
  model       String?
  generatedAt DateTime             @default(now())
  expiresAt   DateTime
  updatedAt   DateTime             @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
}

model StudentProject {
  id            String    @id @default(cuid())
  studentId     String
  title         String
  description   String?
  repositoryUrl String?
  demoUrl       String?
  startedAt     DateTime?
  endedAt       DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
}

model LecturerProfile {
  id           String   @id @default(cuid())
  userId       String   @unique
  fullName     String
  department   String
  title        String?
  avatarFileId String?  @unique
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  avatarFile    File?          @relation("LecturerAvatar", fields: [avatarFileId], references: [id], onDelete: SetNull)
  supervisions  Supervision[]
  conversations Conversation[]
}

model CompanyProfile {
  id                         String        @id @default(cuid())
  userId                     String        @unique
  companyName                String
  businessRegistrationNumber String?       @unique
  contactPersonName          String?
  contactPhone               String?
  tagline                    String?
  description                String?
  industry                   String?
  website                    String?
  address                    String?
  logo                       String?
  contactEmail               String?
  registrationDocumentFileId String?       @unique
  status                     CompanyStatus                @default(DRAFT)
  reviewedById               String?
  reviewedAt                 DateTime?
  rejectionReason            String?
  rejectionReasonCode        CompanyRejectionReasonCode?
  submittedAt                DateTime?
  reviewDueAt                DateTime?
  reviewChecklist            Json?
  suspensionReason           String?
  suspensionReasonCode       CompanySuspensionReasonCode?
  suspendedAt                DateTime?
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt

  user                 User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  reviewedBy           User?                 @relation("CompanyReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  registrationDocument File?                 @relation("CompanyRegistrationDocument", fields: [registrationDocumentFileId], references: [id], onDelete: SetNull)
  internships          Internship[]
  templates            InternshipTemplate[]
  placements           InternshipPlacement[]
  conversations        Conversation[]

  @@index([status])
  @@index([status, reviewDueAt])
  @@index([status, submittedAt])
}

model Semester {
  id        String         @id @default(cuid())
  name      String         @unique
  startDate DateTime
  endDate   DateTime
  status    SemesterStatus @default(UPCOMING)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  internships Internship[]
  placements  InternshipPlacement[]
}

model Skill {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  studentSkills            StudentSkill[]
  internshipSkills         InternshipSkill[]
  internshipTemplateSkills InternshipTemplateSkill[]
}

model StudentSkill {
  studentId String
  skillId   String
  level     SkillLevel @default(BEGINNER)

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  skill   Skill          @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([studentId, skillId])
  @@index([skillId])
}

model InternshipSkill {
  internshipId String
  skillId      String
  isRequired   Boolean @default(true)
  weight       Int     @default(1)

  internship Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  skill      Skill      @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([internshipId, skillId])
  @@index([skillId])
}

model Internship {
  id           String           @id @default(cuid())
  companyId    String
  semesterId   String
  title        String
  department   String?
  location     String?
  workType     String?
  stipend      String?
  description  String
  requirements String?
  slots        Int              @default(1)
  filledSlots  Int              @default(0)
  deadline     DateTime?
  startDate          DateTime?
  endDate            DateTime?
  status             InternshipStatus     @default(DRAFT)
  sourceTemplateId   String?
  sourceInternshipId String?
  viewCount          Int                  @default(0)
  uniqueViewerCount  Int                  @default(0)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  company             CompanyProfile        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  semester            Semester              @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  sourceTemplate      InternshipTemplate?   @relation(fields: [sourceTemplateId], references: [id], onDelete: SetNull)
  sourceInternship    Internship?           @relation("InternshipRepostSource", fields: [sourceInternshipId], references: [id], onDelete: SetNull)
  repostedInternships Internship[]          @relation("InternshipRepostSource")
  skills              InternshipSkill[]
  applications        Application[]
  placements          InternshipPlacement[]
  views               InternshipView[]

  @@index([companyId, status])
  @@index([semesterId, status])
  @@index([deadline])
  @@index([sourceTemplateId])
  @@index([sourceInternshipId])
}

model InternshipTemplate {
  id           String   @id @default(cuid())
  companyId    String
  name         String
  title        String
  department   String?
  location     String?
  workType     String?
  stipend      String?
  description  String
  requirements String?
  slotsDefault Int      @default(1)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  company     CompanyProfile            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  skills      InternshipTemplateSkill[]
  internships Internship[]

  @@unique([companyId, name])
  @@index([companyId, updatedAt])
}

model InternshipTemplateSkill {
  templateId String
  skillId    String
  isRequired Boolean @default(true)
  weight     Int     @default(1)

  template InternshipTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  skill    Skill              @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@id([templateId, skillId])
  @@index([skillId])
}

model InternshipView {
  id            String   @id @default(cuid())
  internshipId  String
  viewerUserId  String
  firstViewedAt DateTime @default(now())
  lastViewedAt  DateTime @default(now())

  internship Internship @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  viewer     User       @relation(fields: [viewerUserId], references: [id], onDelete: Cascade)

  @@unique([internshipId, viewerUserId])
  @@index([internshipId, lastViewedAt])
}

model Application {
  id                     String            @id @default(cuid())
  studentId              String
  internshipId           String
  coverLetter            String?
  cvFileId               String?
  matchScore             Float?
  status                 ApplicationStatus @default(PENDING)
  companyFeedback        String?
  rejectionReason        String?
  offeredAt              DateTime?
  offerExpiresAt         DateTime?
  offerMessage           String?
  offerReminderSentAt    DateTime?
  respondedAt            DateTime?
  appliedAt              DateTime          @default(now())
  acceptedAt             DateTime?
  rejectedAt             DateTime?
  withdrawnAt            DateTime?
  hiddenByStudentAt      DateTime?
  hiddenByCompanyAt      DateTime?
  updatedAt              DateTime          @updatedAt

  student       StudentProfile             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  internship    Internship                 @relation(fields: [internshipId], references: [id], onDelete: Cascade)
  cvFile        File?                      @relation("ApplicationCv", fields: [cvFileId], references: [id], onDelete: SetNull)
  statusHistory ApplicationStatusHistory[]
  interview     ApplicationInterview?
  emailLogs     EmailLog[]
  placement     InternshipPlacement?
  conversation  Conversation?

  @@unique([studentId, internshipId])
  @@index([internshipId, status])
  @@index([studentId, status])
  @@index([status, offerExpiresAt])
}

model ApplicationInterview {
  id            String        @id @default(cuid())
  applicationId String        @unique
  scheduledAt   DateTime
  mode          InterviewMode
  meetingLink   String?
  location      String?
  contactName   String
  contactEmail  String
  contactPhone  String?
  note          String?
  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
}

model EmailLog {
  id            String         @id @default(cuid())
  applicationId String
  type          EmailLogType
  to            String
  replyTo       String?
  subject       String
  html          String
  icsContent    String?
  status        EmailLogStatus
  error         String?
  sentAt        DateTime       @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, sentAt])
}

model ApplicationStatusHistory {
  id            String             @id @default(cuid())
  applicationId String
  fromStatus    ApplicationStatus?
  toStatus      ApplicationStatus
  changedById   String?
  note          String?
  createdAt     DateTime           @default(now())

  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)

  @@index([applicationId, createdAt])
}

model InternshipPlacement {
  id               String                   @id @default(cuid())
  applicationId    String                   @unique
  studentId        String
  companyId        String
  internshipId     String
  semesterId       String
  status           PlacementStatus          @default(PENDING)
  academicStatus   AcademicMonitoringStatus @default(PENDING)
  academicClosedAt DateTime?
  startDate        DateTime?
  endDate          DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  application          Application    @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  student              StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)
  company              CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Restrict)
  internship           Internship     @relation(fields: [internshipId], references: [id], onDelete: Restrict)
  semester             Semester       @relation(fields: [semesterId], references: [id], onDelete: Restrict)
  supervision          Supervision?
  reports              Report[]
  evaluations          Evaluation[]
  lecturerConversation Conversation?  @relation("PlacementConversation")

  @@index([studentId, semesterId])
  @@index([companyId, semesterId])
  @@index([semesterId, status])
  @@index([semesterId, academicStatus])
}

model Supervision {
  id           String            @id @default(cuid())
  placementId  String            @unique
  lecturerId   String
  assignedById String?
  status       SupervisionStatus @default(ACTIVE)
  assignedAt   DateTime          @default(now())
  completedAt  DateTime?

  placement  InternshipPlacement @relation(fields: [placementId], references: [id], onDelete: Cascade)
  lecturer   LecturerProfile     @relation(fields: [lecturerId], references: [id], onDelete: Restrict)
  assignedBy User?               @relation("AssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)

  @@index([lecturerId, status])
}

model Report {
  id          String       @id @default(cuid())
  placementId String
  week        Int
  title       String?
  content     String
  fileId      String?
  status      ReportStatus @default(DRAFT)
  feedback    String?
  submittedAt DateTime?
  reviewedAt  DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  placement InternshipPlacement @relation(fields: [placementId], references: [id], onDelete: Cascade)
  file      File?               @relation("ReportFile", fields: [fileId], references: [id], onDelete: SetNull)

  @@unique([placementId, week])
  @@index([placementId, status])
}

model Evaluation {
  id          String         @id @default(cuid())
  placementId String
  evaluatorId String
  type        EvaluationType
  score       Float
  comment     String?
  submittedAt DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  placement InternshipPlacement @relation(fields: [placementId], references: [id], onDelete: Cascade)
  evaluator User                @relation("EvaluationAuthor", fields: [evaluatorId], references: [id], onDelete: Restrict)

  @@unique([placementId, type])
  @@index([evaluatorId])
}

model File {
  id           String   @id @default(cuid())
  ownerId      String
  type         FileType
  storageKey   String   @unique
  originalName String
  mimeType     String
  sizeBytes    Int
  createdAt    DateTime @default(now())

  owner                       User             @relation("FileOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  studentCv                   StudentProfile?  @relation("StudentCv")
  studentAvatar               StudentProfile?  @relation("StudentAvatar")
  lecturerAvatar              LecturerProfile? @relation("LecturerAvatar")
  applicationCvs              Application[]    @relation("ApplicationCv")
  reportFiles                 Report[]         @relation("ReportFile")
  companyRegistrationDocument CompanyProfile?  @relation("CompanyRegistrationDocument")

  @@index([ownerId, type])
}

model Conversation {
  id            String   @id @default(cuid())
  applicationId String?  @unique
  placementId   String?  @unique
  studentId     String
  companyId     String?
  lecturerId    String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  application Application?         @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  placement   InternshipPlacement? @relation("PlacementConversation", fields: [placementId], references: [id], onDelete: Cascade)
  student     StudentProfile       @relation(fields: [studentId], references: [id], onDelete: Cascade)
  company     CompanyProfile?      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  lecturer    LecturerProfile?     @relation(fields: [lecturerId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@index([studentId])
  @@index([companyId])
  @@index([lecturerId])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model Notification {
  id         String             @id @default(cuid())
  userId     String
  type       NotificationType
  action     NotificationAction @default(NONE)
  title      String
  content    String
  resourceId String?
  metadata   Json?
  eventKey   String             @unique
  isRead     Boolean            @default(false)
  readAt     DateTime?
  createdAt  DateTime           @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, isRead, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String?
  entityId  String?
  metadata  Json?
  ipAddress String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entity, entityId])
  @@index([action, createdAt])
}

model SupportRequest {
  id          String               @id @default(cuid())
  studentId   String
  title       String
  content     String
  status      SupportRequestStatus @default(PENDING)
  adminReply  String?
  repliedById String?
  repliedAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  student   StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  repliedBy User?          @relation("SupportRepliedBy", fields: [repliedById], references: [id], onDelete: SetNull)

  @@index([studentId, createdAt])
  @@index([status, createdAt])
}
