# Database (Railway PostgreSQL)
DATABASE_URL="postgresql://postgres:password@railway-host:5432/internhub?schema=public"

# JWT
JWT_SECRET="replace-with-a-long-random-secret-in-production"
JWT_EXPIRES_IN_SECONDS=900
JWT_REFRESH_EXPIRES_IN_SECONDS=604800
BCRYPT_ROUNDS=12

# App
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
COOKIE_SAME_SITE=lax
THROTTLE_LIMIT=60

# Redis (optional)
REDIS_URL=

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-supabase-service-role-key
FILES_BUCKET=internhub-files
SIGNED_URL_EXPIRES_IN_SECONDS=300
